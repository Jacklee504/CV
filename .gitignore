# macOS and local IDE state
.DS_Store
.idea/
__pycache__/

# Private working notes. These must never be deployed or committed.
private/

# Downloaded credential PDFs are local backups only. Public credential cards
# use issuer-hosted verification links rather than repository file paths.
images/certificates/

# Local design backups
*.before-*.html
assets/css/*.before-*.css

# Generated resume/CV files (DOCX, PDF, and visual QA renders).
# The final PDFs are built by GitHub Actions, so they are not versioned
# here; they exist only as CI artifacts and on the deployed site.
output/*.docx
output/*.pdf
output/**
